{
  "name": "shelfmark-demo",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Runnable end-to-end demo: Entra OAuth, map, select, ingest to a local searchable corpus via FsDocumentSink",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,worker,web -c blue,magenta,green \"tsx watch src/server.ts\" \"tsx watch src/worker.ts\" \"vite web\"",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build web",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "doctor": "node scripts/doctor.mjs",
    "demo:doctor": "node scripts/doctor.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/static": "^8.0.0",
    "@shelfmark/api": "workspace:*",
    "@shelfmark/core": "workspace:*",
    "@shelfmark/ui": "workspace:*",
    "@shelfmark/workflows": "workspace:*",
    "@tanstack/react-virtual": "^3.10.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "fastify": "^5.10.0",
    "mammoth": "^1.8.0",
    "minisearch": "^7.1.0",
    "mongodb": "^7.4.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "engines": { "node": ">=20" }
}
