# shelfmark demo configuration — copy to demo/.env and fill in.
# Run `pnpm doctor` afterwards: it checks every value, pings Mongo and
# Temporal, and prints the EXACT redirect URI to register in Entra.

# ── Required ────────────────────────────────────────────────────────────────

# Externally reachable base URL of the demo (scheme + host, no trailing
# slash). Builds the OAuth redirect URIs — no default, on purpose.
#   pnpm dev            → http://localhost:5173  (Vite origin; /api is proxied)
#   docker compose up   → http://localhost:8787  (server serves the built UI)
PUBLIC_BASE_URL=http://localhost:5173

# Entra app registration (docs/SETUP.md walks through creating one).
# Redirect URI to register: <PUBLIC_BASE_URL>/api/v1/connectors/microsoft/callback
CONNECTOR_MS_CLIENT_ID=<your-entra-application-client-id>
CONNECTOR_MS_CLIENT_SECRET=<your-entra-client-secret-value>

# Signs the short-TTL OAuth state JWT. At least 32 bytes.
# Generate:  openssl rand -base64 48
CONNECTOR_OAUTH_STATE_SECRET=<openssl rand -base64 48>

# AES-256-GCM key encrypting refresh tokens at rest. Base64 of EXACTLY 32 bytes.
# Generate:  openssl rand -base64 32
CONNECTOR_TOKEN_ENCRYPTION_KEY=<openssl rand -base64 32>

# ── Optional (defaults shown) ───────────────────────────────────────────────

# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=shelfmark
# TEMPORAL_ADDRESS=localhost:7233
# PORT=8787

# Where the FsDocumentSink writes the corpus (bytes, sidecars,
# manifest.jsonl, search index). Relative to where the process runs.
# DEMO_DATA_DIR=./data

# Sensitivity labels offered in the UI, as a JSON array. Absent → the label
# UI is hidden entirely (the default hidden-label policy).
# DEMO_LABELS=[{"id":"internal","label":"Internal"},{"id":"public","label":"Public"}]

# Demonstrate the `deferred` ledger lane: files larger than this many MB are
# answered {status:'deferred'} on first pass and accepted on retry.
# DEMO_DEFER_OVER_MB=5

# ── Optional S3 sink (the migration reference) ──────────────────────────────
# DEMO_SINK=s3 switches ingestion to any S3-compatible endpoint.
# DEMO_SINK=fs
# S3_BUCKET=<bucket-name>
# S3_ENDPOINT=<http://localhost:9000 for MinIO; unset for AWS>
# S3_PREFIX=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<access-key-id>
# AWS_SECRET_ACCESS_KEY=<secret-access-key>
