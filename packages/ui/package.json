{
  "name": "@shelfmark/ui",
  "version": "0.0.0",
  "description": "React components for the shelfmark flow \u2014 Connections, DriveMap (consent, live narration stream, inversion landing, selection ledger), IngestStatus \u2014 with en/es-MX i18n and a parity gate",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-setup": "./dist/test-setup.js",
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./dist/tailwind-preset.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/check-parity.mjs && tsup src/index.ts src/test-setup.ts src/tailwind-preset.ts --format esm --dts --sourcemap && cp src/styles.css dist/ 2>/dev/null || true",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1"
  },
  "engines": {
    "node": ">=20"
  }
}
