{
  "name": "@shelfmark/api",
  "version": "0.0.0",
  "description": "Fastify plugin exposing the shelfmark HTTP surface: connections, OAuth callbacks, consent round trips, browse, map (with SSE narration stream), selection, ingest",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@shelfmark/core": "workspace:*",
    "@shelfmark/graph": "workspace:*",
    "@temporalio/client": "^1.11.0",
    "fastify-plugin": "^5.0.0",
    "jose": "^5.10.0",
    "mongodb": "^7.4.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "fastify": "^5.10.0"
  },
  "engines": {
    "node": ">=20"
  }
}
